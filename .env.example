# =========================================================================
# Modele de configuration — a copier en `.env` et a remplir.
#
# Le fichier `.env` n'est jamais versionne : chaque environnement (dev, QA,
# serveur client) a le sien, cree sur place. En production, il doit se
# trouver dans le REPERTOIRE DE TRAVAIL du processus Node (dotenv le cherche
# dans le cwd, pas a cote du fichier index.js) — voir deploy/README.md.
#
# Les 5 premieres variables sont indispensables au demarrage. Les blocs
# GRAPH_* ne bloquent pas le demarrage, mais sans eux les notifications par
# mail et l'envoi de pieces jointes echouent silencieusement a l'usage.
# =========================================================================

# Chaine de connexion SQL Server. `encrypt=true;trustServerCertificate=true`
# convient a un serveur avec certificat auto-signe ; retirer
# trustServerCertificate si le certificat est emis par une AC reconnue.
DATABASE_URL="sqlserver://<hote>:1433;database=<base>;user=<utilisateur>;password=<mot-de-passe>;encrypt=true;trustServerCertificate=true"

# Cle de signature des jetons JWT. A GENERER PAR ENVIRONNEMENT — ne jamais
# reprendre celle d'un autre environnement : qui la connait peut forger un
# jeton valide pour n'importe quel compte.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origine(s) autorisee(s) pour le frontend, separees par des virgules et sans
# barre oblique finale. Si cette variable est absente, seul
# http://localhost:5173 est accepte et le front de production est bloque par
# le navigateur (erreur CORS).
CORS_ORIGIN=https://<domaine-du-frontend>

# Version affichee dans le panneau "A propos" du frontend — a incrementer a
# chaque mise en production, en synchro avec VITE_APP_VERSION cote frontend.
API_VERSION=1.0.0

# Port d'ecoute. Optionnel : 3000 par defaut, et sous IIS/iisnode la valeur
# est imposee par IIS (ne pas la definir dans ce cas).
# PORT=3000

# ── Notifications par mail (Microsoft Graph) ─────────────────────────────
# Application Azure AD avec la permission applicative Mail.Send.
GRAPH_MAIL_TENANT_ID=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
# Boite d'envoi (l'adresse qui apparait comme expediteur).
GRAPH_MAIL_SENDER=
# Conserver une copie dans les elements envoyes de cette boite.
GRAPH_MAIL_SAVE_TO_SENT_ITEMS=false

# ── Pieces jointes (SharePoint via Microsoft Graph) ──────────────────────
# Application Azure AD avec la permission applicative Sites.ReadWrite.All.
GRAPH_SHAREPOINT_TENANT_ID=
GRAPH_SHAREPOINT_CLIENT_ID=
GRAPH_SHAREPOINT_CLIENT_SECRET=
# Hote SharePoint, ex. contoso.sharepoint.com
GRAPH_SHAREPOINT_SITE_HOST=
# Chemin du site, ex. /sites/RH
GRAPH_SHAREPOINT_SITE_PATH=
# Dossier de depot des justificatifs dans la bibliotheque du site.
GRAPH_SHAREPOINT_UPLOAD_PATH=
GRAPH_SHAREPOINT_UPLOAD_PATH=

# =====================================================================
# BACKLOG RECRUTEMENT (branche dev-recrutement-module) - tout optionnel
# =====================================================================

# --- Portail carriere public : anti-spam (defauts permissifs) ---
# Limitation de debit en memoire (un seul process Node). Vide/absent = actif.
CAREERS_RL_DISABLED=
# X-Forwarded-For pris en compte UNIQUEMENT si =true ET le proxy de bord
# ecrase (n'ajoute pas a) l'entete ; le port applicatif ne doit pas etre
# joignable en direct.
CAREERS_TRUST_PROXY=false
CAREERS_RL_APPLY=5
CAREERS_RL_APPLY_WINDOW_MS=60000
CAREERS_RL_READ=60
CAREERS_RL_READ_WINDOW_MS=60000
CAREERS_RL_TOKEN=30
CAREERS_RL_TOKEN_WINDOW_MS=60000
CAREERS_RL_RSVP=30
CAREERS_RL_RSVP_WINDOW_MS=600000
# Secret HMAC du jeton de formulaire. Vide = secret aleatoire par redemarrage.
CAREERS_FORM_SECRET=
# prod recommande : true
CAREERS_FORM_TOKEN_REQUIRED=false
# Duree minimale de remplissage avant acceptation. prod recommande : 4
CAREERS_MIN_FORM_SECONDS=0
# Duree de validite du jeton de formulaire (minutes). prod recommande : 30
CAREERS_MAX_FORM_MINUTES=60
# Cloudflare Turnstile. Vide = captcha desactive.
TURNSTILE_SECRET=
# Comportement si Cloudflare est injoignable. true = on laisse passer.
TURNSTILE_FAIL_OPEN=true

# --- Diffusion multi-plateformes des offres ---
# Autoriser les webhooks vers des hotes prives / boucle locale (n8n auto-heberge). Defaut: bloque.
ALLOW_PRIVATE_WEBHOOKS=
# Autoriser les webhooks en http:// (non chiffre). Defaut: https uniquement.
ALLOW_INSECURE_WEBHOOKS=
# Activer la relance quotidienne automatique des webhooks en echec (cron 6h). Defaut: manuel seulement.
DISTRIBUTION_AUTO_RETRY=
# Titre affiche dans feed.json / feed.xml. Defaut: "Offres d'emploi HV".
FEED_TITLE=

# --- RSVP entretien : endpoint optionnel de reception des reponses .ics ---
# Secret partage de POST /api/public/interview-rsvp/inbound-ics. Non defini => endpoint invisible (404).
RSVP_INBOUND_SECRET=
